# Frontend Environment Variables (for Vite)
# Place this file in your client/ or frontend/ directory

# API Base URL
# For local development (recommended)
VITE_API_URL=http://localhost:5000/api/v1

# If you want to use a deployed backend instead, set this to that API root.
# Example (ONLY if your deployment mounts routes at /api/v1):
# VITE_API_URL=https://your-domain.com/api/v1

